# FROSH AI
OPENAI_API_KEY=
FROSH_MODEL=gpt-6-luna

# API
FROSH_API_URL=http://localhost:3001
# Optional comma-separated HTTPS hosts the research fetcher may access. Leave blank to allow public hosts while blocking private networks.
FROSH_RESEARCH_ALLOWED_HOSTS=

# Database
DATABASE_URL=

# Google Gmail + Calendar OAuth (server-side secrets; never expose in NEXT_PUBLIC_* variables)
# Register this exact URL in Google Cloud as an authorized redirect URI.
# Local development example: http://localhost:3000/api/google/callback
FROSH_PUBLIC_APP_URL=http://localhost:3000
FROSH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once per environment, for example: openssl rand -base64 32
FROSH_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Auth / security
FROSH_AUTH_SECRET=

# Realtime
FROSH_WS_URL=ws://localhost:3001

# Web gateway (server-side only)
FROSH_WEB_TOKEN=
FROSH_DEVICE_ENROLLMENT_TOKEN=
FROSH_USER_ID=default-user

# Automation runner
FROSH_AUTOMATION_USER_ID=default-user
# Device credential lifetime (default 30 days; allowed range 5 minutes to 90 days)
FROSH_DEVICE_CREDENTIAL_TTL_MS=2592000000
# Realtime device credential re-check interval (default 5 seconds; allowed range 1-60 seconds)
FROSH_DEVICE_AUTH_CHECK_INTERVAL_MS=5000

# Local development only: skip control-center Basic auth (ignored in production builds)
# FROSH_WEB_AUTH_DISABLED=true
