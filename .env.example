# FROSH AI
# Set one live provider. Gemini is supported directly and can be used with its
# no-cost developer tier; keep all provider keys server-side.
FROSH_AI_PROVIDER=gemini
GEMINI_API_KEY=
FROSH_GEMINI_MODEL=gemini-2.5-flash
# The interactive-chat transport retry count (0-2; default 1). Retries occur
# only before FROSH has emitted output or started visible tool work.
FROSH_AI_STREAM_RETRIES=1
# Optional alternative provider. Only set this deliberately: it may use a paid
# provider if the primary is temporarily unavailable.
FROSH_AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
FROSH_MODEL=gpt-6-luna

# API
FROSH_API_URL=http://localhost:3001
# Maximum duration of one agent model-execution phase in milliseconds (default 600000, bounded to 10-3600000).
# A timeout stops the active provider request and records a failed run; FROSH never replays its tool work automatically.
FROSH_AGENT_RUN_TIMEOUT_MS=600000
# Optional comma-separated HTTPS hosts the research fetcher may access. Leave blank to allow public hosts while blocking private networks.
FROSH_RESEARCH_ALLOWED_HOSTS=

# Database
DATABASE_URL=

# Google Gmail + Calendar OAuth (server-side secrets; never expose in NEXT_PUBLIC_* variables)
# Register this exact URL in Google Cloud as an authorized redirect URI.
# Local development example: http://localhost:3000/api/google/callback
FROSH_PUBLIC_APP_URL=http://localhost:3000
FROSH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once per environment, for example: openssl rand -base64 32
FROSH_GOOGLE_TOKEN_ENCRYPTION_KEY=

# Auth / security
FROSH_AUTH_SECRET=

# Realtime
FROSH_WS_URL=ws://localhost:3001

# Web gateway (server-side only)
FROSH_WEB_TOKEN=
FROSH_DEVICE_ENROLLMENT_TOKEN=
FROSH_USER_ID=default-user

# Automation runner
FROSH_AUTOMATION_USER_ID=default-user

# Proactive public HTTPS monitoring. A database is required for scheduled checks;
# local/in-memory mode still supports explicit "Check now" requests.
# Set to 0 to disable scheduled monitor workers.
FROSH_MONITORING_ENABLED=1
# Bounded to 10-300000 milliseconds (default 30000).
FROSH_MONITOR_TICK_MS=30000
# Bounded to 30000-120000 milliseconds (default 45000).
FROSH_MONITOR_LEASE_MS=45000

# Device credential lifetime (default 30 days; allowed range 5 minutes to 90 days)
FROSH_DEVICE_CREDENTIAL_TTL_MS=2592000000
# Realtime device credential re-check interval (default 5 seconds; allowed range 1-60 seconds)
FROSH_DEVICE_AUTH_CHECK_INTERVAL_MS=5000

# Local development only: skip control-center Basic auth (ignored in production builds)
# FROSH_WEB_AUTH_DISABLED=true
