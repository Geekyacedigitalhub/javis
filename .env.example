# FROSH AI
OPENAI_API_KEY=
FROSH_MODEL=gpt-6-luna

# API
FROSH_API_URL=http://localhost:3001

# Database
DATABASE_URL=

# Auth / security
FROSH_AUTH_SECRET=

# Realtime
FROSH_WS_URL=ws://localhost:3001

# Web gateway (server-side only)
FROSH_WEB_TOKEN=
FROSH_DEVICE_ENROLLMENT_TOKEN=
FROSH_USER_ID=default-user

# Automation runner
FROSH_AUTOMATION_USER_ID=default-user
# Device credential lifetime (default 30 days; allowed range 5 minutes to 90 days)
FROSH_DEVICE_CREDENTIAL_TTL_MS=2592000000
# Realtime device credential re-check interval (default 5 seconds; allowed range 1-60 seconds)
FROSH_DEVICE_AUTH_CHECK_INTERVAL_MS=5000
