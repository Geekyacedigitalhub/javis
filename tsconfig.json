{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
