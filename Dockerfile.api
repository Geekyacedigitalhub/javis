# Production image for the long-running FROSH Bun API service.
FROM oven/bun:1.4.4-alpine

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY packages ./packages
COPY scripts ./scripts
COPY services ./services

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

# Migrations have a checksum ledger and are safe to run on each deployment.
# The API starts only after its durable stores have the expected schema.
CMD ["sh", "-c", "bun run migrate && exec bun run start"]
