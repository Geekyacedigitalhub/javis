{
  "name": "frosh",
  "private": true,
  "version": "0.1.0",
  "description": "FROSH personal AI operating system",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "bun run services/api/src/http.ts",
    "start": "bun run services/api/src/http.ts",
    "dev:web": "cd apps/web && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "cd apps/web && bun run typecheck",
    "check": "bun run typecheck && bun run typecheck:web && bun run typecheck:mobile",
    "migrate": "bun run scripts/migrate.ts",
    "migrate:dry": "bun run scripts/migrate.ts --dry-run",
    "migrate:verify": "bun run scripts/migrate.ts --verify",
    "test": "bun test",
    "test:unit": "bun test tests/syntax.test.ts tests/missions.test.ts tests/validation.test.ts tests/automation.test.ts tests/migrations.test.ts",
    "test:api": "bun test tests/api.integration.test.ts",
    "typecheck:mobile": "cd apps/mobile && bun run typecheck"
  },
  "dependencies": {
    "postgres": "^3.4.7",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/bun": "latest"
  }
}
