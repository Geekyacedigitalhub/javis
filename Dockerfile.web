# Production image for the FROSH Next.js control center.
FROM oven/bun:1.4.4-alpine

WORKDIR /app

COPY apps/web/package.json apps/web/bun.lock ./
RUN bun install --frozen-lockfile

COPY apps/web ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

ENV PORT=3000
EXPOSE 3000
# Start Next directly so Docker tracks the HTTP server itself. Running it through
# `bun run` adds a script wrapper that can receive Render's lifecycle SIGTERM
# while the child server is still healthy, resulting in intermittent 502s.
CMD ["bun", "./node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0"]
